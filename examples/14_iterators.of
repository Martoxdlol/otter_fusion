import { print } from "of:core";

// `Iterator<T>` is provided by the of:core prelude — no local declaration
// needed. `for x in iter` knows to pull `T` out of any value that
// implements it.

struct Range: Iterator<i64> {
  current: i64,
  end:     i64,

  function next(self): i64 | null {
    if (self.current >= self.end) {
      null
    } else {
      var v = self.current;
      self.current = self.current + 1;
      v
    }
  }
}

function print_all<T>(iter: Iterator<T>) {
  for (item in iter) {
    print(item as str);
  }
}

function main(): i64 {
  var r = Range { current: 0, end: 5 };
  print_all<i64>(r);
  0
}
