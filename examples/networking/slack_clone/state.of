// state.of — in-memory chat store.
//
// Channels, messages, and long-poll waiters live as linked lists hung off
// `ChatState`. No List<T> / Map<K,V> runtime is available, so every
// collection is a head pointer + `next: T | null` field. Channel and
// message counts in a demo stay small enough that O(n) lookups don't
// matter.

import { println } from "of:core";
import { json_str } from "json";

// ----- Messages ----------------------------------------------------------

struct Message {
  id: i64,
  user: str,
  text: str,
  next: Message | null,
}

// ----- Channels ----------------------------------------------------------
//
// `next_id` is the id the NEXT message will take. So if a channel has
// posted 3 messages, ids are 1,2,3 and `next_id == 4`. Clients ask for
// "messages since N" meaning "messages with id > N".

struct Channel {
  name: str,
  head: Message | null,
  tail: Message | null,
  next_id: i64,
  next: Channel | null,
}

extend Channel {
  function append(self, user: str, text: str): i64 {
    var id = self.next_id;
    self.next_id = id + (1 as i64);
    var m = Message { id: id, user: user, text: text, next: null };
    if (self.tail is null) {
      self.head = m;
    } else {
      var prev = self.tail as Message;
      prev.next = m;
    }
    self.tail = m;
    id
  }

  // Build the JSON payload for a long-poll response: every message with
  // id > since, plus the new high-water mark.
  function poll_json(self, since: i64): str {
    var msgs = "";
    var first = true;
    var p: Message | null = self.head;
    while (p is Message) {
      var m = p as Message;
      if (m.id > since) {
        var entry = "{\"id\":" + (m.id as str)
                  + ",\"user\":" + json_str(m.user)
                  + ",\"text\":" + json_str(m.text) + "}";
        if (first) {
          msgs = entry;
          first = false;
        } else {
          msgs = msgs + "," + entry;
        }
      }
      p = m.next;
    }
    var next_cursor = self.next_id - (1 as i64);
    "{\"messages\":[" + msgs + "],\"next\":" + (next_cursor as str) + "}"
  }
}

// ----- Waiters -----------------------------------------------------------
//
// A `Waiter` is a long-poll request that didn't have new data when it
// arrived. We hold its connection state and wake it up when (a) the
// channel receives a message it'd want, or (b) its deadline passes.

struct Waiter {
  fd: i32,
  channel: str,
  since: i64,
  deadline_ms: i64,
  next: Waiter | null,
}

// ----- ChatState ---------------------------------------------------------

struct ChatState {
  channels: Channel | null,
  waiters: Waiter | null,

  function new(): ChatState {
    ChatState { channels: null, waiters: null }
  }
}

extend ChatState {
  // Look up a channel by name, or create-and-prepend if absent.
  function ensure_channel(self, name: str): Channel {
    var p: Channel | null = self.channels;
    while (p is Channel) {
      var c = p as Channel;
      if (c.name == name) {
        return c;
      }
      p = c.next;
    }
    var fresh = Channel {
      name: name,
      head: null,
      tail: null,
      next_id: 1 as i64,
      next: self.channels,
    };
    self.channels = fresh;
    fresh
  }

  // Look up without creating. Used by /poll so unknown channels look empty
  // rather than appearing in the channel list on first poll.
  function find_channel(self, name: str): Channel | null {
    var p: Channel | null = self.channels;
    while (p is Channel) {
      var c = p as Channel;
      if (c.name == name) {
        return c;
      }
      p = c.next;
    }
    null
  }

  function add_waiter(self, fd: i32, channel: str, since: i64, deadline_ms: i64) {
    var w = Waiter {
      fd: fd,
      channel: channel,
      since: since,
      deadline_ms: deadline_ms,
      next: self.waiters,
    };
    self.waiters = w;
  }

  // Walk the waiters list, unlinking and returning the first one matching
  // `(channel, since < cursor)` — the caller responds to it, then calls
  // again to drain. Returns null when no waiter is eligible.
  function take_woken(self, channel: str, cursor: i64): Waiter | null {
    var prev: Waiter | null = null;
    var p: Waiter | null = self.waiters;
    while (p is Waiter) {
      var w = p as Waiter;
      if (w.channel == channel && cursor > w.since) {
        if (prev is null) {
          self.waiters = w.next;
        } else {
          var pv = prev as Waiter;
          pv.next = w.next;
        }
        w.next = null;
        return w;
      }
      prev = p;
      p = w.next;
    }
    null
  }

  // Same shape as take_woken but matches on a passed deadline. Drives the
  // "long poll timed out → respond with []" branch.
  function take_expired(self, now_ms: i64): Waiter | null {
    var prev: Waiter | null = null;
    var p: Waiter | null = self.waiters;
    while (p is Waiter) {
      var w = p as Waiter;
      if (w.deadline_ms <= now_ms) {
        if (prev is null) {
          self.waiters = w.next;
        } else {
          var pv = prev as Waiter;
          pv.next = w.next;
        }
        w.next = null;
        return w;
      }
      prev = p;
      p = w.next;
    }
    null
  }

  // Smallest deadline across all waiters, or -1 if none. Reactor uses this
  // to bound the select() timeout so expirations fire promptly.
  function earliest_deadline(self): i64 {
    var best: i64 = (0 as i64) - (1 as i64);
    var p: Waiter | null = self.waiters;
    while (p is Waiter) {
      var w = p as Waiter;
      if (best < (0 as i64) || w.deadline_ms < best) {
        best = w.deadline_ms;
      }
      p = w.next;
    }
    best
  }

  // Unlink whatever waiter (if any) is currently parked on `fd`. Used when
  // a client disconnects mid-wait so we don't try to write to its closed fd.
  function drop_waiter_for_fd(self, fd: i32) {
    var prev: Waiter | null = null;
    var p: Waiter | null = self.waiters;
    while (p is Waiter) {
      var w = p as Waiter;
      if (w.fd == fd) {
        if (prev is null) {
          self.waiters = w.next;
        } else {
          var pv = prev as Waiter;
          pv.next = w.next;
        }
        return;
      }
      prev = p;
      p = w.next;
    }
  }

  // Comma-separated, sorted-by-insertion list of channel names — used to
  // build the JSON {"channels":[...]} response.
  function channels_json(self): str {
    var body = "";
    var first = true;
    var p: Channel | null = self.channels;
    while (p is Channel) {
      var c = p as Channel;
      var entry = json_str(c.name);
      if (first) {
        body = entry;
        first = false;
      } else {
        body = body + "," + entry;
      }
      p = c.next;
    }
    "{\"channels\":[" + body + "]}"
  }
}

// Debug print so the operator can see what's in memory at startup.
function debug_dump(s: ChatState) {
  println("-- chat state --");
  var p: Channel | null = s.channels;
  while (p is Channel) {
    var c = p as Channel;
    println("  channel " + c.name + " next_id=" + (c.next_id as str));
    p = c.next;
  }
}
