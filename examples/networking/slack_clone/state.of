// state.of — in-memory chat store, backed by `List<T>`.
//
// Each channel keeps its messages in a List in insertion order. Waiters
// (long-poll requests parked until either a new message arrives or their
// deadline passes) sit in a second List on ChatState. `next_id` is the id
// the NEXT message will take; "messages since N" means "messages with id > N".

import { println } from "of:core";
import { json_str } from "json";

struct Message {
  id: i64,
  user: str,
  text: str,
}

struct Channel {
  name: str,
  messages: List<Message>,
  next_id: i64,
}

extend Channel {
  function append(self, user: str, text: str): i64 {
    var id = self.next_id;
    self.next_id = id + (1 as i64);
    self.messages.push(Message { id: id, user: user, text: text });
    id
  }

  // JSON for a long-poll response: every message with id > since, plus the
  // new high-water mark.
  function poll_json(self, since: i64): str {
    var msgs = "";
    var first = true;
    for (m in self.messages) {
      if (m.id > since) {
        var entry = "{\"id\":" + (m.id as str)
                  + ",\"user\":" + json_str(m.user)
                  + ",\"text\":" + json_str(m.text) + "}";
        if (first) {
          msgs = entry;
          first = false;
        } else {
          msgs = msgs + "," + entry;
        }
      }
    }
    var next_cursor = self.next_id - (1 as i64);
    "{\"messages\":[" + msgs + "],\"next\":" + (next_cursor as str) + "}"
  }
}

struct Waiter {
  fd: i32,
  channel: str,
  since: i64,
  deadline_ms: i64,
}

struct ChatState {
  channels: List<Channel>,
  waiters: List<Waiter>,

  function new(): ChatState {
    ChatState {
      channels: List.new<Channel>(),
      waiters: List.new<Waiter>(),
    }
  }
}

extend ChatState {
  // Look up a channel by name, or create it (and append to the list) if absent.
  function ensure_channel(self, name: str): Channel {
    for (c in self.channels) {
      if (c.name == name) {
        return c;
      }
    }
    var fresh = Channel { name: name, messages: List.new<Message>(), next_id: 1 as i64 };
    self.channels.push(fresh);
    fresh
  }

  // Look up without creating. Used by /poll so unknown channels look empty
  // rather than appearing in the channel list on first poll.
  function find_channel(self, name: str): Channel | null {
    for (c in self.channels) {
      if (c.name == name) {
        return c;
      }
    }
    null
  }

  function add_waiter(self, fd: i32, channel: str, since: i64, deadline_ms: i64) {
    self.waiters.push(Waiter {
      fd: fd, channel: channel, since: since, deadline_ms: deadline_ms,
    });
  }

  // Take the first waiter matching `(channel, since < cursor)` out of the
  // list and return it. Caller responds to it, then loops. Returns null when
  // no waiter is eligible.
  function take_woken(self, channel: str, cursor: i64): Waiter | null {
    var i: i64 = 0 as i64;
    while (i < self.waiters.size()) {
      var w_or = self.waiters.get(i);
      if (w_or is Waiter) {
        var w = w_or as Waiter;
        if (w.channel == channel && cursor > w.since) {
          self.waiters.remove(i);
          return w;
        }
      }
      i = i + (1 as i64);
    }
    null
  }

  // Same shape, but matches on an elapsed deadline. Drives the "long poll
  // timed out → respond with []" branch.
  function take_expired(self, now_ms: i64): Waiter | null {
    var i: i64 = 0 as i64;
    while (i < self.waiters.size()) {
      var w_or = self.waiters.get(i);
      if (w_or is Waiter) {
        var w = w_or as Waiter;
        if (w.deadline_ms <= now_ms) {
          self.waiters.remove(i);
          return w;
        }
      }
      i = i + (1 as i64);
    }
    null
  }

  // Smallest deadline across all waiters, or -1 if none. Reactor uses this
  // to bound the select() timeout so expirations fire promptly.
  function earliest_deadline(self): i64 {
    var best: i64 = (0 as i64) - (1 as i64);
    for (w in self.waiters) {
      if (best < (0 as i64) || w.deadline_ms < best) {
        best = w.deadline_ms;
      }
    }
    best
  }

  // Unlink any waiter (if any) parked on `fd`. Used when a client disconnects
  // mid-wait so we don't try to write to its closed fd.
  function drop_waiter_for_fd(self, fd: i32) {
    var i: i64 = 0 as i64;
    while (i < self.waiters.size()) {
      var w_or = self.waiters.get(i);
      if (w_or is Waiter) {
        var w = w_or as Waiter;
        if (w.fd == fd) {
          self.waiters.remove(i);
          return;
        }
      }
      i = i + (1 as i64);
    }
  }

  // Comma-separated, insertion-order channel names — used to build
  // {"channels":[...]}.
  function channels_json(self): str {
    var body = "";
    var first = true;
    for (c in self.channels) {
      var entry = json_str(c.name);
      if (first) {
        body = entry;
        first = false;
      } else {
        body = body + "," + entry;
      }
    }
    "{\"channels\":[" + body + "]}"
  }
}

// Debug print so the operator can see what's in memory at startup.
function debug_dump(s: ChatState) {
  println("-- chat state --");
  for (c in s.channels) {
    println("  channel " + c.name + " next_id=" + (c.next_id as str));
  }
}
