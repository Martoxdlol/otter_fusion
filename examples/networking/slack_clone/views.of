// views.of — the single HTML/CSS/JS page the server serves at `/`.
//
// Vanilla JS: the page polls /poll?channel=X&since=N&wait=25 in a loop,
// appends messages as they arrive, POSTs to /send when the user submits.
// `wait=25` (seconds) makes the server hold the request open until either
// a new message arrives or the deadline passes — that's the long-poll.

function page(): str {
  "<!doctype html>\n"
  + "<html lang=\"en\"><head><meta charset=\"utf-8\"/><title>of-slack</title>\n"
  + "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/>\n"
  + "<style>\n"
  + ":root {\n"
  + "  --bg-side: #19171d; --bg-side-hover: rgba(255,255,255,.07);\n"
  + "  --bg-side-active: #1164a3; --side-fg: #d9d6d9; --side-fg-dim: #9b969b;\n"
  + "  --bg: #ffffff; --fg: #1d1c1d; --fg-dim: #696969;\n"
  + "  --border: #e8e8e8; --accent: #007a5a; --danger: #e01e5a;\n"
  + "  --bubble-hover: #f8f8f8;\n"
  + "}\n"
  + "* { box-sizing: border-box; }\n"
  + "html,body { height: 100%; margin: 0; }\n"
  + "body { font: 14px/1.45 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\n"
  + "       color: var(--fg); background: var(--bg);\n"
  + "       display: grid; grid-template-columns: 240px 1fr; height: 100vh; overflow: hidden; }\n"
  + "\n"
  + "aside { background: var(--bg-side); color: var(--side-fg); display: flex; flex-direction: column; min-height: 0; }\n"
  + ".brand { padding: 16px; font-size: 16px; font-weight: 700; letter-spacing: -.01em; color: #fff;\n"
  + "         border-bottom: 1px solid rgba(255,255,255,.08); display: flex; align-items: center; gap: 8px; }\n"
  + ".brand .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px rgba(0,122,90,.18); }\n"
  + ".brand .dot.off { background: var(--danger); box-shadow: 0 0 0 3px rgba(224,30,90,.18); }\n"
  + ".side-scroll { flex: 1; overflow-y: auto; padding: 8px 4px 16px; }\n"
  + ".side-h { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: var(--side-fg-dim); padding: 12px 12px 4px; }\n"
  + ".side-row { padding: 5px 12px; border-radius: 4px; cursor: pointer; user-select: none;\n"
  + "            display: flex; align-items: center; gap: 6px; margin: 0 4px; }\n"
  + ".side-row:hover { background: var(--bg-side-hover); }\n"
  + ".side-row.active { background: var(--bg-side-active); color: #fff; }\n"
  + ".side-row .hash { color: var(--side-fg-dim); font-weight: 500; }\n"
  + ".side-row.active .hash { color: rgba(255,255,255,.85); }\n"
  + ".you-row { padding: 4px 12px 8px 16px; display: flex; align-items: center; gap: 8px; color: var(--side-fg); }\n"
  + ".you-row .avatar { width: 26px; height: 26px; font-size: 11px; }\n"
  + ".addch { padding: 6px 12px 12px; }\n"
  + ".addch input { width: 100%; background: rgba(255,255,255,.06); border: 1px solid transparent;\n"
  + "               color: #fff; padding: 6px 10px; border-radius: 4px; font: inherit; }\n"
  + ".addch input:focus { outline: none; border-color: rgba(255,255,255,.18); background: rgba(255,255,255,.10); }\n"
  + ".addch input::placeholder { color: var(--side-fg-dim); }\n"
  + "\n"
  + "main { display: flex; flex-direction: column; min-height: 0; }\n"
  + "header.topbar { display: flex; align-items: center; gap: 10px;\n"
  + "                padding: 12px 20px; border-bottom: 1px solid var(--border);\n"
  + "                font-weight: 700; font-size: 15px; }\n"
  + "header.topbar .ch-name { display: flex; align-items: baseline; gap: 4px; }\n"
  + "header.topbar .ch-name .hash { color: var(--fg-dim); font-weight: 400; }\n"
  + "header.topbar .ch-meta { color: var(--fg-dim); font-weight: 400; font-size: 12px; margin-left: 8px; }\n"
  + "\n"
  + "#feed { flex: 1; overflow-y: auto; padding: 16px 0 12px; }\n"
  + "#empty { color: var(--fg-dim); padding: 40px 24px; max-width: 420px; }\n"
  + "#empty h3 { margin: 0 0 6px; color: var(--fg); font-size: 18px; }\n"
  + "#empty p { margin: 0; }\n"
  + ".msg { display: grid; grid-template-columns: 36px 1fr; gap: 10px; padding: 6px 20px 6px 16px; }\n"
  + ".msg:hover { background: var(--bubble-hover); }\n"
  + ".msg.continuation { padding-top: 2px; padding-bottom: 2px; }\n"
  + ".msg.continuation .avatar { visibility: hidden; }\n"
  + ".msg.continuation .head { display: none; }\n"
  + ".avatar { width: 36px; height: 36px; border-radius: 6px; color: #fff;\n"
  + "          display: flex; align-items: center; justify-content: center;\n"
  + "          font-weight: 600; font-size: 13px; text-transform: uppercase; }\n"
  + ".head { display: flex; align-items: baseline; gap: 6px; margin-bottom: 1px; }\n"
  + ".who { font-weight: 700; color: var(--fg); }\n"
  + ".time { color: var(--fg-dim); font-size: 11px; }\n"
  + ".body { white-space: pre-wrap; word-wrap: break-word; }\n"
  + "\n"
  + "#composer { padding: 12px 16px 18px; }\n"
  + "#composer .wrap { display: flex; gap: 8px; align-items: center;\n"
  + "                  border: 1px solid var(--border); border-radius: 8px;\n"
  + "                  padding: 4px 4px 4px 12px; transition: border-color .12s; }\n"
  + "#composer .wrap:focus-within { border-color: #888; }\n"
  + "#composer input { flex: 1; border: 0; padding: 8px 0; font: inherit; color: var(--fg);\n"
  + "                  background: transparent; outline: none; }\n"
  + "#composer button { border: 0; background: var(--accent); color: #fff;\n"
  + "                   padding: 6px 12px; border-radius: 6px; font-weight: 600; cursor: pointer; }\n"
  + "#composer button:disabled { background: #c4c4c4; cursor: not-allowed; }\n"
  + "\n"
  + "::-webkit-scrollbar { width: 8px; }\n"
  + "::-webkit-scrollbar-thumb { background: rgba(0,0,0,.18); border-radius: 4px; }\n"
  + "aside ::-webkit-scrollbar-thumb { background: rgba(255,255,255,.14); }\n"
  + "</style></head>\n"
  + "<body>\n"
  + "<aside>\n"
  + "  <div class=\"brand\"><span id=\"dot\" class=\"dot\" title=\"connecting...\"></span><span>of-slack</span></div>\n"
  + "  <div class=\"side-h\">You</div>\n"
  + "  <div class=\"you-row\" id=\"you-row\"></div>\n"
  + "  <div class=\"side-h\">Channels</div>\n"
  + "  <div class=\"side-scroll\"><div id=\"chs\"></div></div>\n"
  + "  <form class=\"addch\" id=\"newch\"><input id=\"newch-name\" placeholder=\"+ add channel\" autocomplete=\"off\"/></form>\n"
  + "</aside>\n"
  + "<main>\n"
  + "  <header class=\"topbar\">\n"
  + "    <div class=\"ch-name\"><span class=\"hash\">#</span><span id=\"ch-title\">general</span></div>\n"
  + "    <div class=\"ch-meta\" id=\"ch-meta\"></div>\n"
  + "  </header>\n"
  + "  <div id=\"feed\"></div>\n"
  + "  <form id=\"composer\"><div class=\"wrap\">\n"
  + "    <input id=\"msg\" autocomplete=\"off\" placeholder=\"Message #general\"/>\n"
  + "    <button id=\"send\" type=\"submit\" disabled>Send</button>\n"
  + "  </div></form>\n"
  + "</main>\n"
  + "<script>\n"
  + "(() => {\n"
  + "  const $ = (id) => document.getElementById(id);\n"
  + "  const state = {\n"
  + "    channel: 'general',\n"
  + "    since: 0,\n"
  + "    user: localStorage.getItem('user') || (prompt('Your name?') || 'anon').trim() || 'anon',\n"
  + "    lastSender: null,\n"
  + "  };\n"
  + "  localStorage.setItem('user', state.user);\n"
  + "\n"
  + "  const PALETTE = ['#1264a3','#007a5a','#e8912d','#cc4d3a','#b15ea0','#5a30a3','#4a5566','#2c8d8f','#9a6f0b','#615a85'];\n"
  + "  function hash(s) { let h = 0; for (const c of s) h = ((h<<5)-h + c.charCodeAt(0))|0; return Math.abs(h); }\n"
  + "  function avatarFor(name) {\n"
  + "    const el = document.createElement('div'); el.className = 'avatar';\n"
  + "    el.style.background = PALETTE[hash(name) % PALETTE.length];\n"
  + "    el.textContent = (name || '?').trim().slice(0,1).toUpperCase() || '?';\n"
  + "    return el;\n"
  + "  }\n"
  + "  function fmtTime(d) {\n"
  + "    const h = d.getHours(), m = d.getMinutes();\n"
  + "    const hh = ((h+11)%12)+1, mm = m<10?('0'+m):m, ap = h<12?'AM':'PM';\n"
  + "    return hh + ':' + mm + ' ' + ap;\n"
  + "  }\n"
  + "\n"
  + "  const you = $('you-row');\n"
  + "  you.appendChild(avatarFor(state.user));\n"
  + "  const youName = document.createElement('span'); youName.textContent = state.user; you.appendChild(youName);\n"
  + "\n"
  + "  const chs = $('chs');\n"
  + "  let channelList = ['general'];\n"
  + "  function renderChannels(list) {\n"
  + "    chs.innerHTML = '';\n"
  + "    for (const name of list) {\n"
  + "      const row = document.createElement('div'); row.className = 'side-row';\n"
  + "      if (name === state.channel) row.classList.add('active');\n"
  + "      const h = document.createElement('span'); h.className='hash'; h.textContent='#';\n"
  + "      const n = document.createElement('span'); n.textContent = name;\n"
  + "      row.appendChild(h); row.appendChild(n);\n"
  + "      row.onclick = () => switchChannel(name);\n"
  + "      chs.appendChild(row);\n"
  + "    }\n"
  + "  }\n"
  + "  async function loadChannels() {\n"
  + "    try {\n"
  + "      const r = await fetch('/channels');\n"
  + "      const j = await r.json();\n"
  + "      const merged = Array.from(new Set([state.channel, ...(j.channels || [])])).sort();\n"
  + "      channelList = merged;\n"
  + "      renderChannels(merged);\n"
  + "    } catch (e) { /* keep prior list */ }\n"
  + "  }\n"
  + "\n"
  + "  const feed = $('feed');\n"
  + "  function showEmpty() {\n"
  + "    feed.innerHTML = '';\n"
  + "    const e = document.createElement('div'); e.id = 'empty';\n"
  + "    const h3 = document.createElement('h3'); h3.textContent = '#' + state.channel;\n"
  + "    const p = document.createElement('p');\n"
  + "    p.textContent = 'This is the start of the channel. Say hello.';\n"
  + "    e.appendChild(h3); e.appendChild(p);\n"
  + "    feed.appendChild(e);\n"
  + "  }\n"
  + "  function appendMessages(messages) {\n"
  + "    if (!messages.length) return;\n"
  + "    const empty = $('empty'); if (empty) empty.remove();\n"
  + "    const nearBottom = feed.scrollHeight - feed.scrollTop - feed.clientHeight < 80;\n"
  + "    for (const m of messages) {\n"
  + "      const wrap = document.createElement('div'); wrap.className = 'msg';\n"
  + "      const cont = state.lastSender === m.user;\n"
  + "      if (cont) wrap.classList.add('continuation');\n"
  + "      wrap.appendChild(avatarFor(m.user));\n"
  + "      const right = document.createElement('div');\n"
  + "      const head = document.createElement('div'); head.className = 'head';\n"
  + "      const who = document.createElement('span'); who.className = 'who'; who.textContent = m.user;\n"
  + "      const tm  = document.createElement('span'); tm.className = 'time'; tm.textContent = fmtTime(new Date());\n"
  + "      head.appendChild(who); head.appendChild(tm);\n"
  + "      const body = document.createElement('div'); body.className = 'body'; body.textContent = m.text;\n"
  + "      right.appendChild(head); right.appendChild(body);\n"
  + "      wrap.appendChild(right);\n"
  + "      feed.appendChild(wrap);\n"
  + "      state.lastSender = m.user;\n"
  + "    }\n"
  + "    if (nearBottom) feed.scrollTop = feed.scrollHeight;\n"
  + "  }\n"
  + "\n"
  + "  const dot = $('dot');\n"
  + "  function setStatus(live) { dot.classList.toggle('off', !live); dot.title = live ? 'connected' : 'reconnecting...'; }\n"
  + "\n"
  + "  let polling = null;\n"
  + "  async function poll() {\n"
  + "    const ctrl = new AbortController(); polling = ctrl;\n"
  + "    try {\n"
  + "      const url = '/poll?channel=' + encodeURIComponent(state.channel) + '&since=' + state.since + '&wait=25';\n"
  + "      const r = await fetch(url, { signal: ctrl.signal });\n"
  + "      const j = await r.json();\n"
  + "      setStatus(true);\n"
  + "      appendMessages(j.messages || []);\n"
  + "      if (typeof j.next === 'number' && j.next > state.since) state.since = j.next;\n"
  + "    } catch (e) {\n"
  + "      if (e.name !== 'AbortError') { setStatus(false); await new Promise(r => setTimeout(r, 800)); }\n"
  + "    }\n"
  + "    if (polling === ctrl) poll();\n"
  + "  }\n"
  + "\n"
  + "  function switchChannel(name) {\n"
  + "    if (name === state.channel) return;\n"
  + "    state.channel = name; state.since = 0; state.lastSender = null;\n"
  + "    $('ch-title').textContent = name;\n"
  + "    $('msg').placeholder = 'Message #' + name;\n"
  + "    showEmpty();\n"
  + "    renderChannels(channelList);\n"
  + "    if (polling) { const p = polling; polling = null; p.abort(); }\n"
  + "    poll();\n"
  + "  }\n"
  + "\n"
  + "  const input = $('msg'), send = $('send');\n"
  + "  input.addEventListener('input', () => { send.disabled = input.value.trim().length === 0; });\n"
  + "  $('composer').onsubmit = async (e) => {\n"
  + "    e.preventDefault();\n"
  + "    const text = input.value.trim(); if (!text) return;\n"
  + "    input.value = ''; send.disabled = true; input.focus();\n"
  + "    const body = 'channel=' + encodeURIComponent(state.channel) + '&user=' + encodeURIComponent(state.user) + '&text=' + encodeURIComponent(text);\n"
  + "    try {\n"
  + "      await fetch('/send', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });\n"
  + "    } catch (e) { setStatus(false); }\n"
  + "  };\n"
  + "  $('newch').onsubmit = async (e) => {\n"
  + "    e.preventDefault();\n"
  + "    const inp = $('newch-name'); const name = inp.value.trim();\n"
  + "    if (!name) return;\n"
  + "    await fetch('/channels', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: 'channel=' + encodeURIComponent(name) });\n"
  + "    inp.value = '';\n"
  + "    await loadChannels();\n"
  + "    switchChannel(name);\n"
  + "  };\n"
  + "\n"
  + "  $('ch-title').textContent = state.channel;\n"
  + "  $('msg').placeholder = 'Message #' + state.channel;\n"
  + "  showEmpty();\n"
  + "  loadChannels();\n"
  + "  poll();\n"
  + "})();\n"
  + "</script></body></html>\n"
}
