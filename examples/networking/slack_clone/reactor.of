// reactor.of — connection table + read/write helpers backing the event loop.
//
// One ConnState per accepted client. The table is a `List<ConnState>`; the
// reactor walks it each tick to build select() fd_sets and to find conns to
// wake. Three phases:
//
//   READING — buffered request bytes accumulating; selected for readability.
//   WRITING — response bytes prebuilt; selected for writability.
//   WAITING — long-poll in flight, parked in ChatState.waiters; this conn is
//             in NEITHER fd_set until either a message arrives or the deadline
//             passes, at which point it gets flipped back to WRITING.
//
// The reactor loop itself lives in slack.of so it can call into route()
// without indirection (the language has no usable function-pointer/lambda
// values yet).

import { println, Buffer, __of_buffer_free } from "of:core";
import {
  TcpListener,
  IoError,
  __of_buffer_from_str,
  __of_close,
  __of_read,
  __of_write,
  __of_errno,
  fd_set_nonblocking,
} from "of_io";
import { Response, Request, parse_request_bytes } from "web_server";

const PHASE_READING: i32 = 0;
const PHASE_WRITING: i32 = 1;
const PHASE_WAITING: i32 = 2;

const READ_CAP: u64 = 8192;

struct ConnState {
  fd: i32,
  phase: i32,
  read_buf: Buffer,
  read_len: i64,
  write_buf: Buffer | null,
  write_size: u64,
  write_pos: u64,
}

extend ConnState {
  // Stage a Response for writing. Frees any previous write_buf. Caller
  // is responsible for transitioning phase (so dispatch can decide between
  // "respond now" and "respond after wakeup").
  function start_writing(self, resp: Response) {
    var old = self.write_buf;
    if (old is Buffer) {
      __of_buffer_free(old as Buffer);
    }
    var buf_or = __of_buffer_from_str(resp.as_http());
    if (buf_or is null) {
      self.write_buf = null;
      self.write_size = 0 as u64;
      self.write_pos = 0 as u64;
      return;
    }
    var b = buf_or as Buffer;
    self.write_buf = b;
    self.write_size = b.size;
    self.write_pos = 0 as u64;
    self.phase = PHASE_WRITING;
  }

  // Release fd + every Buffer the conn owns. Called once at connection
  // teardown — the list unlink is the caller's responsibility.
  function free_all(self) {
    __of_close(self.fd);
    __of_buffer_free(self.read_buf);
    var wb = self.write_buf;
    if (wb is Buffer) {
      __of_buffer_free(wb as Buffer);
      self.write_buf = null;
    }
  }
}

// Try to make a ConnState for `fd`. Allocates the read buffer up-front; if
// that fails we just close the fd and bail.
function make_conn(fd: i32): ConnState | null {
  var buf_or = Buffer.alloc(READ_CAP);
  if (buf_or is null) {
    __of_close(fd);
    return null;
  }
  var nb = fd_set_nonblocking(fd, true);
  if (nb is IoError) {
    println("set_nonblocking: " + (nb as IoError).message());
  }
  ConnState {
    fd: fd,
    phase: PHASE_READING,
    read_buf: buf_or as Buffer,
    read_len: 0 as i64,
    write_buf: null,
    write_size: 0 as u64,
    write_pos: 0 as u64,
  }
}

struct Reactor {
  listener: TcpListener,
  conns: List<ConnState>,

  function new(listener: TcpListener): Reactor {
    Reactor { listener: listener, conns: List.new<ConnState>() }
  }
}

extend Reactor {
  function push_conn(self, c: ConnState) {
    self.conns.push(c);
  }

  // Linear scan to find a conn by fd. The caller wants the value back, not
  // the index, so use this for read-only lookups.
  function find_by_fd(self, fd: i32): ConnState | null {
    for (c in self.conns) {
      if (c.fd == fd) {
        return c;
      }
    }
    null
  }

  // Same scan, but returns the index so the caller can mutate via remove().
  function index_of_fd(self, fd: i32): i64 {
    var i: i64 = 0 as i64;
    while (i < self.conns.size()) {
      var c_or = self.conns.get(i);
      if (c_or is ConnState) {
        if ((c_or as ConnState).fd == fd) {
          return i;
        }
      }
      i = i + (1 as i64);
    }
    (0 as i64) - (1 as i64)
  }

  // Unlink the conn matching `fd` (if any) and run its teardown.
  function close_fd(self, fd: i32) {
    var idx = self.index_of_fd(fd);
    if (idx < (0 as i64)) {
      return;
    }
    var c_or = self.conns.remove(idx);
    if (c_or is ConnState) {
      (c_or as ConnState).free_all();
    }
  }

  // Move a parked WAITING conn back into write mode with the given response.
  // Returns false if no conn with that fd was found.
  function wake_fd(self, fd: i32, resp: Response): bool {
    var c_or = self.find_by_fd(fd);
    if (c_or is ConnState) {
      (c_or as ConnState).start_writing(resp);
      return true;
    }
    false
  }
}

// Read more bytes into c.read_buf at offset c.read_len. The kernel only
// fills starting at byte 0 of the Buffer we hand it, so we splice via a
// transient ReadResult and copy the tail in. Returns:
//   > 0 — bytes appended
//   0  — EOF
//  -1  — would block (caller continues; no error)
//  -2  — other I/O error (caller closes the conn)
function read_more(c: ConnState): i64 {
  var remaining = READ_CAP - (c.read_len as u64);
  if (remaining == (0 as u64)) {
    return (0 as i64) - (2 as i64);
  }
  var tmp_or = Buffer.alloc(remaining);
  if (tmp_or is null) {
    return (0 as i64) - (2 as i64);
  }
  var tmp = tmp_or as Buffer;
  var n = __of_read(c.fd, tmp, remaining);
  if (n < (0 as i64)) {
    var err = __of_errno();
    __of_buffer_free(tmp);
    if (err == (35 as i32) || err == (11 as i32)) {
      return (0 as i64) - (1 as i64);
    }
    return (0 as i64) - (2 as i64);
  }
  if (n == (0 as i64)) {
    __of_buffer_free(tmp);
    return 0 as i64;
  }
  var i: u64 = 0 as u64;
  var nu = n as u64;
  var base: u64 = c.read_len as u64;
  while (i < nu) {
    c.read_buf.set(base + i, tmp.get(i));
    i = i + (1 as u64);
  }
  __of_buffer_free(tmp);
  c.read_len = c.read_len + n;
  n
}

// Try to parse what we've buffered so far as a full HTTP request. Returns
// null while more bytes are still needed (headers not finished, or body
// still arriving), an IoError if the request line is malformed, or the
// Request itself.
function try_parse(c: ConnState): Request | IoError | null {
  if (c.read_len <= (0 as i64)) {
    return null;
  }
  if (request_incomplete(c.read_buf, c.read_len)) {
    return null;
  }
  var parsed = parse_request_bytes(c.read_buf, c.read_len);
  if (parsed is IoError) {
    return parsed as IoError;
  }
  var req: Request | IoError | null = parsed as Request;
  req
}

// True until we have headers (CRLFCRLF / LFLF) AND Content-Length bytes
// after them. Without this check, a proxy that flushes headers and body
// in separate writes (common on TLS-terminating front ends) makes us
// parse a request before its body has arrived. Content-Length defaults
// to 0; capped at READ_CAP so a runaway claim can't wedge the conn.
function request_incomplete(buf: Buffer, len: i64): bool {
  var headers_end = find_headers_end(buf, len);
  if (headers_end < (0 as i64)) {
    return true;
  }
  var content_len = parse_content_length(buf, headers_end);
  if (content_len < (0 as i64)) {
    content_len = 0 as i64;
  }
  var needed = headers_end + content_len;
  if (needed > (READ_CAP as i64)) {
    return false;
  }
  len < needed
}

// Offset of the byte AFTER the blank line that terminates the headers,
// or -1 if no blank line is buffered yet.
function find_headers_end(buf: Buffer, len: i64): i64 {
  var n = len as u64;
  var i: u64 = 0 as u64;
  while (i < n) {
    var b = buf.get(i);
    if (b == (13 as u8) && i + (3 as u64) < n
        && buf.get(i + (1 as u64)) == (10 as u8)
        && buf.get(i + (2 as u64)) == (13 as u8)
        && buf.get(i + (3 as u64)) == (10 as u8)) {
      return (i + (4 as u64)) as i64;
    }
    if (b == (10 as u8) && i + (1 as u64) < n && buf.get(i + (1 as u64)) == (10 as u8)) {
      return (i + (2 as u64)) as i64;
    }
    i = i + (1 as u64);
  }
  (0 as i64) - (1 as i64)
}

// Walk the header block, returning the first Content-Length value
// (case-insensitive), or 0 if absent.
function parse_content_length(buf: Buffer, end: i64): i64 {
  var tgt_or = __of_buffer_from_str("content-length");
  if (tgt_or is null) {
    return 0 as i64;
  }
  var tgt = tgt_or as Buffer;
  var result: i64 = 0 as i64;
  var i = end_of_line(buf, 0 as i64, end);
  while (i < end) {
    var line_start = i;
    var line_end = end_of_line(buf, i, end);
    if (line_end <= line_start) {
      i = end;
    } else {
      var colon = scan_in_range(buf, line_start, line_end, 58 as u8);
      if (colon > line_start && header_name_matches(buf, line_start, colon, tgt)) {
        result = parse_decimal_after(buf, colon + (1 as i64), line_end);
        i = end;
      } else {
        i = line_end;
      }
    }
  }
  __of_buffer_free(tgt);
  result
}

// Offset just past the next \r\n (or bare \n), or `end` if neither is found.
function end_of_line(buf: Buffer, start: i64, end: i64): i64 {
  var i = start;
  var found: i64 = end;
  while (i < end) {
    var b = buf.get(i as u64);
    if (b == (10 as u8)) {
      found = i + (1 as i64);
      i = end;
    } else if (b == (13 as u8) && (i + (1 as i64)) < end && buf.get((i + (1 as i64)) as u64) == (10 as u8)) {
      found = i + (2 as i64);
      i = end;
    } else {
      i = i + (1 as i64);
    }
  }
  found
}

function scan_in_range(buf: Buffer, start: i64, end: i64, target: u8): i64 {
  var found: i64 = (0 as i64) - (1 as i64);
  var i = start;
  while (i < end) {
    if (buf.get(i as u64) == target) {
      found = i;
      i = end;
    } else {
      i = i + (1 as i64);
    }
  }
  found
}

// Case-insensitive ASCII compare of buf[start..end) against `tgt`.
function header_name_matches(buf: Buffer, start: i64, end: i64, tgt: Buffer): bool {
  var name_len = end - start;
  if ((tgt.size as i64) != name_len) {
    return false;
  }
  var ok = true;
  var i: i64 = 0 as i64;
  while (i < name_len) {
    var b = ascii_lower(buf.get((start + i) as u64));
    if (b != tgt.get(i as u64)) {
      ok = false;
      i = name_len;
    } else {
      i = i + (1 as i64);
    }
  }
  ok
}

function ascii_lower(b: u8): u8 {
  if (b >= (65 as u8) && b <= (90 as u8)) {
    b + (32 as u8)
  } else {
    b
  }
}

// Skip ASCII spaces/tabs, then parse a non-negative decimal up to the
// first non-digit. Returns 0 if no digit is seen.
function parse_decimal_after(buf: Buffer, start: i64, end: i64): i64 {
  var i = start;
  var skipping = true;
  while (skipping && i < end) {
    var b = buf.get(i as u64);
    if (b == (32 as u8) || b == (9 as u8)) {
      i = i + (1 as i64);
    } else {
      skipping = false;
    }
  }
  var v: i64 = 0 as i64;
  var parsing = true;
  while (parsing && i < end) {
    var b = buf.get(i as u64);
    if (b >= (48 as u8) && b <= (57 as u8)) {
      v = v * (10 as i64) + ((b as i64) - (48 as i64));
      i = i + (1 as i64);
    } else {
      parsing = false;
    }
  }
  v
}

// Push whatever's left of write_buf to the socket. Returns true if the
// write fully drained (caller should close the conn), false otherwise.
function write_more(c: ConnState): bool {
  if (c.write_buf is null) {
    return true;
  }
  var buf = c.write_buf as Buffer;
  if (c.write_pos >= c.write_size) {
    return true;
  }
  var remaining = c.write_size - c.write_pos;
  // The extern wants a base pointer + length; we don't have pointer arith
  // exposed to of-land, so we splice via a temporary that starts at offset 0.
  var tmp_or = Buffer.alloc(remaining);
  if (tmp_or is null) {
    return false;
  }
  var tmp = tmp_or as Buffer;
  var i: u64 = 0 as u64;
  while (i < remaining) {
    tmp.set(i, buf.get(c.write_pos + i));
    i = i + (1 as u64);
  }
  var n = __of_write(c.fd, tmp, remaining);
  __of_buffer_free(tmp);
  if (n <= (0 as i64)) {
    var err = __of_errno();
    if (err == (35 as i32) || err == (11 as i32)) {
      return false;
    }
    c.write_pos = c.write_size;
    return true;
  }
  c.write_pos = c.write_pos + (n as u64);
  c.write_pos >= c.write_size
}
