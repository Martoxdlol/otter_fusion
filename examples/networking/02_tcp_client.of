// TCP client that connects to 127.0.0.1:8080, sends "ping\n", reads the
// reply, and prints it. Pairs with 01_tcp_echo_server.of (start it first).

import { println } from "of:core";
import { TcpStream, ReadResult, IoError, write } from "of_io";

function main(): i64 {
  var connect_res = TcpStream.connect("127.0.0.1", 8080 as u16);
  if (connect_res is IoError) {
    println("connect: " + (connect_res as IoError).message());
    return 1;
  }
  var sock = connect_res as TcpStream;
  println("connected to 127.0.0.1:8080");

  var sent = sock.write_str("ping\n");
  if (sent is IoError) {
    println("write: " + (sent as IoError).message());
  } else {
    println("sent " + ((sent as i64) as str) + " bytes");
  }

  var read_res = sock.read(256 as u64);
  if (read_res is IoError) {
    println("read: " + (read_res as IoError).message());
  } else {
    var r = read_res as ReadResult;
    println("received " + (r.len as str) + " bytes:");
    write(1, r.buf, r.len as u64);
    r.free();
  }

  sock.close();
  0
}
