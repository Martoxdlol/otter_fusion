// Non-blocking server on 127.0.0.1:8081 using select() with a 2-second
// timeout. If no client connects in time it prints "timeout" and exits;
// otherwise it accepts the connection and exits.
//
// Demonstrates: TcpListener.set_nonblocking(true), FdSet construction,
// and the select() free function with millisecond timeout.

import { println } from "of:core";
import { TcpListener, TcpStream, FdSet, IoError, select } from "of_io";

function main(): i64 {
  var listener_or_err = TcpListener.bind("127.0.0.1", 8081 as u16, 1);
  if (listener_or_err is IoError) {
    println("bind: " + (listener_or_err as IoError).message());
    return 1;
  }
  var listener = listener_or_err as TcpListener;

  var nb = listener.set_nonblocking(true);
  if (nb is IoError) {
    println("set_nonblocking: " + (nb as IoError).message());
    listener.close();
    return 1;
  }

  println("waiting up to 2s for a connection on 127.0.0.1:8081");

  var rs = FdSet.new();
  rs.add(listener.fd);

  var ready = select(listener.fd + 1, rs, null, null, 2000 as i64);
  if (ready is IoError) {
    println("select: " + (ready as IoError).message());
  } else if ((ready as i32) == 0) {
    println("timeout, no client connected");
  } else if (rs.isset(listener.fd)) {
    var accept_res = listener.accept();
    if (accept_res is IoError) {
      println("accept: " + (accept_res as IoError).message());
    } else {
      var client = accept_res as TcpStream;
      println("accepted client fd=" + (client.fd as str));
      client.close();
    }
  }

  rs.free();
  listener.close();
  0
}
