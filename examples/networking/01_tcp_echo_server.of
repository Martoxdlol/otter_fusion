// Single-connection TCP echo server on 127.0.0.1:8080.
// Accepts ONE client through the of_io facade, echoes a single buffer,
// closes, and exits. Pair with 02_tcp_client.of in another terminal.

import { println } from "of:core";
import { TcpListener, TcpStream, ReadResult, IoError } from "of_io";

function main(): i64 {
  var listener_or_err = TcpListener.bind("127.0.0.1", 8080 as u16, 1);
  if (listener_or_err is IoError) {
    println("bind: " + (listener_or_err as IoError).message());
    return 1;
  }
  var listener = listener_or_err as TcpListener;
  println("listening on 127.0.0.1:8080");

  var accept_res = listener.accept();
  if (accept_res is IoError) {
    println("accept: " + (accept_res as IoError).message());
    listener.close();
    return 1;
  }
  var client = accept_res as TcpStream;
  println("client connected");

  var read_res = client.read(1024 as u64);
  if (read_res is IoError) {
    println("read: " + (read_res as IoError).message());
  } else {
    var r = read_res as ReadResult;
    println("read " + (r.len as str) + " bytes; echoing");
    var w = client.write(r.buf, r.len as u64);
    if (w is IoError) {
      println("write: " + (w as IoError).message());
    }
    r.free();
  }

  client.close();
  listener.close();
  0
}
